{
  "name": "claude-code",
  "displayName": "Claude Code",
  "version": "1",
  "hooks": true,
  "subagents": true,
  "slashCommands": true,
  "worktrees": true,
  "headless": true,
  "headlessCommand": "claude --dangerously-skip-permissions --print --output-format stream-json --verbose",
  "printBackgroundCeilingEnv": "CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS",
  "usageFormat": "claude-stream-json",
  "telemetry": "native",
  "skillFormat": "markdown-with-frontmatter",
  "skillsDir": ".claude/skills",
  "commandsDir": ".claude/commands",
  "agentsDir": ".claude/agents",
  "enforces": {
    "allowed_writes": "tool-call-time",
    "stoplist": "tool-call-time",
    "shell": true,
    "network": true,
    "tool_budget": "native"
  }
}
